# Copy settings into backend/.env after applying the email migration. Never put them in VITE_*.
EMAIL_ENABLED=false
EMAIL_ROUTINE_ENABLED=false
# Use brevo for live sending, capture for local development only.
EMAIL_MODE=capture
PUBLIC_APP_URL=http://localhost:8080
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the existing key when migrating an installation.
EMAIL_ENCRYPTION_KEY=
# Brevo API key (not an SMTP key), available under Settings > SMTP & API.
BREVO_API_KEY=
# Verify this sender/domain in Brevo before enabling delivery.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Enverga Library
# Brevo Free allowance. Counts this app's API attempts; provider usage may differ.
EMAIL_DAILY_LIMIT=300
EMAIL_SECURITY_RESERVE=50
# Daily application counter rolls over automatically at 00:00 UTC.
EMAIL_DIGEST_TIMEZONE=Asia/Manila
EMAIL_DIGEST_TIME=09:00
